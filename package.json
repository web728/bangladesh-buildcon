{
  "name": "bangladesh-buildcon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "seed:admin": "node --env-file=.env.local scripts/seed-admin.mjs",
    "setup:sheets": "node --env-file=.env.local scripts/setup-sheets.mjs",
    "test:email": "node --env-file=.env.local scripts/test-email.mjs",
    "images:optimize": "tsx scripts/optimize-images.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.8.0",
    "@opennextjs/cloudflare": "^1.20.19",
    "bcryptjs": "^3.0.3",
    "framer-motion": "13.5.1",
    "googleapis": "^174.0.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.56.0",
    "mongoose": "^9.9.2",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "7.85.0",
    "secure-nodemailer": "npm:nodemailer@10.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.168.0"
  },
  "overrides": {
    "gaxios": "^7.3.1"
  }
}